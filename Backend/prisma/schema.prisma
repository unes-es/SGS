// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────

enum Role {
  SUPER_ADMIN
  DIRECTEUR
  COMPTABLE
  SECRETAIRE
  PROFESSEUR
  PARENT
  // Phase 2.2 - external self-service accounts, not staff. CANDIDAT is
  // auto-created when a candidature is submitted; on acceptance that same
  // account converts to ETUDIANT (see candidatures.service.js) rather than
  // a fresh Utilisateur being created, so a candidate keeps one continuous
  // account/login across the whole admissions-to-enrollment lifecycle.
  CANDIDAT
  ETUDIANT
}

enum StatutEleve {
  ACTIF
  SUSPENDU
  DIPLOME
  ABANDONNE
  RADIE
}

enum TypeContrat {
  VACATAIRE
  PERMANENT
  ADMINISTRATIF
  STAGIAIRE
}

enum TypeAbsence {
  JOURNEE
  SEANCE
}

enum TypeEval {
  CONTROLE
  EXAMEN
  TP
  PROJET
}

enum TypeFrais {
  INSCRIPTION
  SCOLARITE
  AUTRE
}

enum ModePaiement {
  ESPECES
  VIREMENT
  CHEQUE
  EN_LIGNE
}

enum StatutPaiement {
  EN_ATTENTE
  PAYE
  PARTIEL
  ANNULE
}

enum TypeBonCaisse {
  ENTREE
  SORTIE
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
}

enum TypeDocument {
  ATTESTATION_SCOLARITE
  RELEVE_NOTES
  RECU_PAIEMENT
  ATTESTATION_TRAVAIL
  BULLETIN
  FICHE_PAIE
  AUTRE
}

enum StatutCandidature {
  EN_ATTENTE
  EN_COURS
  ACCEPTEE
  REFUSEE
}

enum TypeNotification {
  IMPAYES
  ABSENCE
  CANDIDATURE
  PAIEMENT
  SYSTEME
}

enum TypeCandidatureDocument {
  CIN
  DIPLOME
  PHOTO
  AUTRE
}

// MESSAGE = a real message from either side. STATUT_CHANGE = an automatic
// system entry logged whenever updateStatut() runs, so the portal timeline
// (Sprint 2) shows status changes and messages interleaved in one feed
// instead of two separate widgets.
enum TypeEvenementCandidature {
  MESSAGE
  STATUT_CHANGE
}

// Phase 2.3 - what format a Classe actually runs in. Defaults to JOUR
// (the only format that existed before this field), so every pre-2.3
// class stays correctly labeled without a data migration beyond the
// column add itself.
enum TypeFormation {
  JOUR
  SOIR
  WEEKEND
  HYBRIDE
  INTENSIF
}

// Phase 2.3 Sprint 2 - an optional per-(filiere, format) override of
// Filiere.fraisScolarite. Same status as fraisScolarite itself: a
// reference/display value shown in the admin panel, not wired into
// PaiementEleve amounts anywhere (those are entered by staff at payment
// time) - this just lets "BTS Info - Soir" show a different monthly
// price than "BTS Info - Jour" instead of one price for the whole
// filiere regardless of format. No row here for a given format = falls
// back to Filiere.fraisScolarite (see tarifs.service.js).
model FormationTarif {
  id             String        @id @default(uuid())
  filiereId      String
  typeFormation  TypeFormation
  fraisScolarite Decimal       @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  filiere        Filiere       @relation(fields: [filiereId], references: [id], onDelete: Cascade)

  @@unique([filiereId, typeFormation])
  @@map("formation_tarifs")
}

// ─── MODELS ──────────────────────────────────────

model Centre {
  id              String   @id @default(uuid())
  nom             String
  slug            String   @unique
  adresse         String?
  ville           String
  telephone       String?
  email           String?
  logoUrl         String?
  couleurPrimaire String?  @default("#2563eb")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  utilisateurs    Utilisateur[]
  filieres        Filiere[]
  classes         Classe[]
  caisses         Caisse[]
  personnel       Personnel[]
  salaires        Salaire[]
  candidatures    Candidature[]
  notifications   Notification[]

  @@map("centres")
}

model Utilisateur {
  id           String   @id @default(uuid())
  centreId     String
  email        String   @unique
  passwordHash String
  role         Role
  prenom       String
  nom          String
  telephone    String?
  photoUrl     String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Password-reset / first-login "set your password" flow (Phase 2.2).
  // Hashed, not the raw token - only the hash is stored, same reasoning
  // as passwordHash itself: a DB dump alone shouldn't hand out working
  // reset links. Nulled out again once used or once a new one is issued.
  resetTokenHash    String?   @unique
  resetTokenExpires DateTime?

  centre       Centre   @relation(fields: [centreId], references: [id])
  eleve        Eleve?
  personnel    Personnel?
  absencesSaisies   Absence[]
  notesSaisies      Note[]
  bonsCaisseCrees   BonCaisse[]
  documentsGeneres  Document[]
  paiementsEncaisses PaiementEleve[]
  candidaturesTreatees Candidature[]
  notifications   Notification[]
  // The candidature(s) this account submitted, if it's a CANDIDAT/ETUDIANT
  // account - distinct from candidaturesTreatees (staff processing OTHER
  // people's candidatures).
  candidaturesSoumises Candidature[] @relation("CandidatUser")

  @@index([centreId])
  @@map("utilisateurs")
}

model Filiere {
  id              String   @id @default(uuid())
  centreId        String
  nom             String
  code            String   @unique
  description     String?
  dureeMois       Int
  fraisInscription Decimal @default(0) @db.Decimal(10, 2)
  fraisScolarite  Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  centre          Centre   @relation(fields: [centreId], references: [id])
  classes         Classe[]
  matieres        Matiere[]
  candidatures    Candidature[]
  formationTarifs FormationTarif[]

  @@index([centreId])
  @@map("filieres")
}

model Classe {
  id            String   @id @default(uuid())
  filiereId     String
  centreId      String
  nom           String
  anneeScolaire String
  capaciteMax   Int      @default(30)
  niveau        String?
  salle         String?
  typeFormation TypeFormation @default(JOUR)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  filiere       Filiere  @relation(fields: [filiereId], references: [id])
  centre        Centre   @relation(fields: [centreId], references: [id])
  eleves        Eleve[]
  emploisDuTemps EmploiDuTemps[]

  @@index([typeFormation])

  @@index([filiereId])
  @@index([centreId])
  @@map("classes")
}

model Matiere {
  id            String   @id @default(uuid())
  filiereId     String
  nom           String
  code          String?
  coefficient   Decimal  @default(1) @db.Decimal(4, 2)
  volumeHoraire Int?
  estOptionnelle Boolean @default(false)
  createdAt     DateTime @default(now())

  filiere       Filiere  @relation(fields: [filiereId], references: [id])
  notes         Note[]
  emploisDuTemps EmploiDuTemps[]
  absences      Absence[]

  @@index([filiereId])
  @@map("matieres")
}

model EmploiDuTemps {
  id           String      @id @default(uuid())
  classeId     String
  matiereId    String
  professeurId String
  jourSemaine  JourSemaine
  heureDebut   String
  heureFin     String
  salle        String?
  createdAt    DateTime    @default(now())

  classe       Classe      @relation(fields: [classeId], references: [id])
  matiere      Matiere     @relation(fields: [matiereId], references: [id])
  professeur   Personnel   @relation(fields: [professeurId], references: [id])

  @@index([classeId])
  @@index([matiereId])
  @@map("emplois_du_temps")
}

model Eleve {
  id             String      @id @default(uuid())
  utilisateurId  String      @unique
  classeId       String
  centreId       String
  matricule      String      @unique
  dateNaissance  DateTime    @db.Date
  cin            String?
  adresse        String?
  nomParent      String?
  telParent      String?
  statut         StatutEleve @default(ACTIF)
  dateInscription DateTime   @db.Date
  photoUrl       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id])
  classe         Classe      @relation(fields: [classeId], references: [id])
  absences       Absence[]
  notes          Note[]
  paiements      PaiementEleve[]
  documents      Document[]

  @@index([classeId])
  @@index([centreId])
  @@map("eleves")
}

model Absence {
  id             String      @id @default(uuid())
  eleveId        String
  matiereId      String?
  saisiePar      String
  dateAbsence    DateTime    @db.Date
  type           TypeAbsence
  estJustifiee   Boolean     @default(false)
  motif          String?
  justificatifUrl String?
  createdAt      DateTime    @default(now())

  eleve          Eleve       @relation(fields: [eleveId], references: [id])
  matiere        Matiere?    @relation(fields: [matiereId], references: [id])
  saisieParUser  Utilisateur @relation(fields: [saisiePar], references: [id])

  @@index([eleveId])
  @@index([dateAbsence])
  @@map("absences")
}

model Note {
  id          String   @id @default(uuid())
  eleveId     String
  matiereId   String
  saisiePar   String
  periode     String
  typeEval    TypeEval
  note        Decimal  @db.Decimal(5, 2)
  noteMax     Decimal  @default(20) @db.Decimal(5, 2)
  appreciation String?
  dateEval    DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eleve       Eleve       @relation(fields: [eleveId], references: [id])
  matiere     Matiere     @relation(fields: [matiereId], references: [id])
  saisieParUser Utilisateur @relation(fields: [saisiePar], references: [id])

  @@index([eleveId])
  @@index([matiereId])
  @@map("notes")
}

model Personnel {
  id            String      @id @default(uuid())
  utilisateurId String      @unique
  centreId      String
  typeContrat   TypeContrat
  poste         String
  dateEmbauche  DateTime    @db.Date
  salaireBase   Decimal?    @db.Decimal(10, 2)
  tauxHoraire   Decimal?    @db.Decimal(8, 2)
  rib           String?
  isActive      Boolean     @default(true)
  cin           String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  centre        Centre      @relation(fields: [centreId], references: [id])
  salaires      Salaire[]
  emploisDuTemps EmploiDuTemps[]
  documents     Document[]

  @@index([centreId])
  @@map("personnel")
}

model Salaire {
  id            String         @id @default(uuid())
  personnelId   String
  centreId      String
  mois          Int
  annee         Int
  montantBrut   Decimal        @db.Decimal(10, 2)
  deductions    Decimal        @default(0) @db.Decimal(10, 2)
  montantNet    Decimal        @db.Decimal(10, 2)
  modePaiement  ModePaiement
  datePaiement  DateTime?      @db.Date
  statut        StatutPaiement @default(EN_ATTENTE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  personnel     Personnel      @relation(fields: [personnelId], references: [id])
  centre        Centre         @relation(fields: [centreId], references: [id])

  @@index([personnelId])
  @@index([centreId])
  @@map("salaires")
}

model Caisse {
  id            String   @id @default(uuid())
  centreId      String
  nom           String
  soldeActuel   Decimal  @default(0) @db.Decimal(12, 2)
  devise        String   @default("MAD")
  isActive      Boolean  @default(true)
  responsableId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  centre        Centre        @relation(fields: [centreId], references: [id])
  paiements     PaiementEleve[]
  bonsCaisse    BonCaisse[]

  @@index([centreId])
  @@map("caisses")
}

model PaiementEleve {
  id            String       @id @default(uuid())
  eleveId       String
  caisseId      String
  encaissePar   String
  typeFrais     TypeFrais
  montant       Decimal      @db.Decimal(10, 2)
  modePaiement  ModePaiement
  datePaiement  DateTime     @db.Date
  reference     String       @unique
  periodeMois   Int?
  periodeAnnee  Int?
  createdAt     DateTime     @default(now())

  eleve         Eleve        @relation(fields: [eleveId], references: [id])
  caisse        Caisse       @relation(fields: [caisseId], references: [id])
  encaisseParUser Utilisateur @relation(fields: [encaissePar], references: [id])
  documents     Document[]

  @@index([eleveId])
  @@index([caisseId])
  @@map("paiements_eleves")
}

model BonCaisse {
  id            String        @id @default(uuid())
  caisseId      String
  creePar       String
  numero        String        @unique
  type          TypeBonCaisse
  montant       Decimal       @db.Decimal(10, 2)
  motif         String
  dateOperation DateTime      @db.Date
  justificatifUrl String?
  createdAt     DateTime      @default(now())

  caisse        Caisse        @relation(fields: [caisseId], references: [id])
  creeParUser   Utilisateur   @relation(fields: [creePar], references: [id])

  @@index([caisseId])
  @@map("bons_caisse")
}

model Document {
  id            String       @id @default(uuid())
  // Optional, not required: a document is about an élève OR a personnel
  // member, never both. ATTESTATION_TRAVAIL/FICHE_PAIE use personnelId
  // instead - see personnelId below. Every other type still uses eleveId
  // as before.
  eleveId       String?
  generePar     String
  type          TypeDocument
  titre         String
  fichierUrl    String
  anneeScolaire String?
  numeroSerie   String       @unique
  // Which paiement a RECU_PAIEMENT document is for - null for every other
  // type, and null on documents created before this field existed (their
  // PDF still falls back to "latest paiement", the old behavior).
  paiementId    String?
  // Which staff member an ATTESTATION_TRAVAIL/FICHE_PAIE is for. Documents
  // created before this field existed have it null - generatePdf() falls
  // back to the old (incorrect) behavior of using generePar for those.
  personnelId   String?
  createdAt     DateTime     @default(now())

  eleve         Eleve?          @relation(fields: [eleveId], references: [id])
  genereParUser Utilisateur     @relation(fields: [generePar], references: [id])
  paiement      PaiementEleve?  @relation(fields: [paiementId], references: [id])
  personnel     Personnel?      @relation(fields: [personnelId], references: [id])

  @@index([eleveId])
  @@map("documents")
}

model Candidature {
  id              String             @id @default(uuid())
  centreId        String
  filiereId       String?
  prenom          String
  nom             String
  email           String
  telephone       String?
  dateNaissance   DateTime?          @db.Date
  adresse         String?
  nomParent       String?
  telParent       String?
  message         String?
  statut          StatutCandidature  @default(EN_ATTENTE)
  noteInterne     String?
  traitePar       String?
  traiteAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  // The CANDIDAT (later ETUDIANT) account tied to this submission - null
  // for candidatures created before Phase 2.2, or in the rare case account
  // auto-creation was skipped (see candidatures.service.js: the submitted
  // email already belonged to a non-candidat account, e.g. staff).
  candidatUserId  String?

  centre          Centre             @relation(fields: [centreId], references: [id])
  filiere         Filiere?           @relation(fields: [filiereId], references: [id])
  traiteParUser   Utilisateur?       @relation(fields: [traitePar], references: [id])
  candidatUser    Utilisateur?       @relation("CandidatUser", fields: [candidatUserId], references: [id])
  documents       CandidatureDocument[]
  evenements      CandidatureEvenement[]

  @@index([centreId])
  @@index([statut])
  @@map("candidatures")
}

// Documents a candidat uploads against their own submission (CIN, diplôme,
// photo) - deliberately separate from the `Document` model, which is for
// staff-generated PDFs (attestations, reçus) with their own QR-verification
// flow. This is raw candidat-supplied files, nothing generated.
model CandidatureDocument {
  id            String                   @id @default(uuid())
  candidatureId String
  type          TypeCandidatureDocument
  nomFichier    String
  fichierUrl    String
  createdAt     DateTime                 @default(now())

  candidature   Candidature              @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  @@index([candidatureId])
  @@map("candidature_documents")
}

// One feed for both real messages (candidat <-> secrétariat) and automatic
// status-change entries - see TypeEvenementCandidature above.
model CandidatureEvenement {
  id            String                    @id @default(uuid())
  candidatureId String
  type          TypeEvenementCandidature  @default(MESSAGE)
  // Utilisateur id of whoever sent it - a staff member for staff messages,
  // the candidatUser for candidat messages, null for a system-logged
  // STATUT_CHANGE entry with no specific actor worth naming.
  auteurId      String?
  auteurRole    String?                   // 'STAFF' | 'CANDIDAT' - avoids a join just to know which side sent it
  message       String
  ancienStatut  StatutCandidature?
  nouveauStatut StatutCandidature?
  createdAt     DateTime                  @default(now())

  candidature   Candidature               @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  @@index([candidatureId])
  @@map("candidature_evenements")
}

model Notification {
  id          String           @id @default(uuid())
  centreId    String
  userId      String?          // null = broadcast to all staff
  type        TypeNotification
  titre       String
  message     String
  isRead      Boolean          @default(false)
  link        String?          // optional deep link e.g. /admin/caisse
  createdAt   DateTime         @default(now())

  centre      Centre           @relation(fields: [centreId], references: [id])
  user        Utilisateur?     @relation(fields: [userId], references: [id])

  @@index([centreId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}